{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage Mail",
  "mainBinaryName": "vantage-mail",
  "version": "0.8.17",
  "identifier": "org.asteroffice.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vantage Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 520,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'sha256-uflZAL03gKNceYBhK4rTMyiSzpwAylbzPGOk/EWgZtY='",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' ext: http://ext.localhost https://ext.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Vantage Mail email client",
    "longDescription": "Vantage Mail is the email client for the Vantage Productivity suite, based on Depesha and compatible with IMAP and SMTP servers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gnome-keyring | kwalletmanager | keepassxc"
        ],
        "desktopTemplate": "depesha.desktop"
      },
      "appimage": {}
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "vantage-mail",
          "aster-mail"
        ]
      }
    }
  }
}
