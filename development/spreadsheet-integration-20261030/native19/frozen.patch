+    }))).rejects.toThrow('timed out')
+    const mutation = reserveFileMutation([{ path: source, kind: 'file' }, { path: destination, kind: 'file' }])
+    const actual = mutation.run(async () => {
+      await moveWorkbookExclusively(source, destination, expected); moved.resolve()
+      await checkpoint.promise; await rendererActual.promise
+    })
+    await flush(); expect(existsSync(source)).toBe(true); expect(existsSync(destination)).toBe(false)
+    publisher.resolve(); await moved.promise
+    expect(existsSync(source)).toBe(false)
+    expect(() => withFilePublication({ targetPath: destination }, async () => undefined)).toThrow('file move is pending')
+    checkpoint.resolve(); await flush()
+    expect(() => reserveFileMutation([{ path: destination, kind: 'file' }])).toThrow('file move is pending')
+    rendererActual.resolve(); await actual
+    const next = reserveFileMutation([{ path: destination, kind: 'file' }]); await next.ready; next.cancelPending()
+    expect(await readFile(destination, 'utf8')).toBe('loaded workbook bytes')
+  })
