  "usage": {
    "logo": "Preserve artwork proportions and colors; do not invert the full-color logo. Use the master on white or use a separately prepared approved dark lockup. Use the saddle mark alone for small app icons.",
    "surfaces": "Use neutral surfaces for most of the interface; reserve blue for interactive emphasis and navy for text and identity.",
    "borders": "Decorative dividers are not sufficient to identify a control. Use borderControl when the boundary is necessary.",
    "status": "Keep an explicit text label or icon with status colors; do not communicate meaning by color alone.",
    "documentData": "Do not recolor document content, cells, charts, PDF pages, print output or exports. Preserve per-editor identification accents.",
    "themeCopies": "Keep light, explicit dark and system dark token blocks synchronized."
  },
